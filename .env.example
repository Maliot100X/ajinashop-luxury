# AJINASHOP Luxury - Environment Variables

# GitHub
GITHUB_TOKEN=your_github_token_here

# Vercel
VERCEL_TOKEN=your_vercel_token_here

# Deepgram API
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_SPEAK_MODEL=aura-2-odysseus-en

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Application
APP_URL=https://ajinashop-luxury.vercel.app
APP_NAME=AJINASHOP
APP_DESCRIPTION=Luxury Beauty E-commerce

# Features
ENABLE_VOICE_ASSISTANT=true
ENABLE_WHATSAPP=true
ENABLE_SMS_NOTIFICATIONS=true

# Currency
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,CAD

# Email (for order notifications)
ORDER_NOTIFICATION_EMAIL=orders@ajinashop.com
SUPPORT_EMAIL=support@ajinashop.com